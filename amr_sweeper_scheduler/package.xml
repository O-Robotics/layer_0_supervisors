<?xml version="1.0"?>
<package format="3">
  <name>amr_sweeper_scheduler</name>
  <version>0.1.0</version>
  <description>ROS 2 scheduler that parses iCalendar (.ics) schedules and resolves VDA5050 mission windows.</description>
  <maintainer email="devnull@example.com">AMR Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>amr_sweeper_layer_0_fsm</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
