<?xml version="1.0"?>
<package format="3">
  <name>amr_sweeper_mission_builder</name>
  <version>0.1.0</version>
  <description>Asynchronous VDA5050 mission artifact builder for AMR Sweeper.</description>
  <maintainer email="info@O-Robotics.com">O-Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <build_depend>libgeographiclib-dev</build_depend>
  <exec_depend>libgeographiclib-dev</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
