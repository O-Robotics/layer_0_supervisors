<?xml version="1.0"?>
<package format="3">
  <name>amr_sweeper_mission_executor</name>
  <version>0.1.0</version>
  <description>Mission activation APIs that route scheduled and manual missions into the correct RUNNING profiles.</description>
  <maintainer email="devnull@example.com">AMR Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>libzip-dev</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>libzip-dev</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <depend>ament_index_cpp</depend>
  <exec_depend>amr_sweeper_navigation</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>amr_sweeper_fsm</depend>
  <depend>amr_sweeper_safety_msgs</depend>
  <depend>amr_sweeper_mission_builder</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
