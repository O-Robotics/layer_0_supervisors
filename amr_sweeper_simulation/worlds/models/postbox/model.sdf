<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="postbox">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry>
          <box>
            <size>0.7 0.5 1.5</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://postbox/meshes/postbox.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://postbox/materials/textures/postbox_diffuse.jpg</albedo_map>
              <roughness>0.72</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
