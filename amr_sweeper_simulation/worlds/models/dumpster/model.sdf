<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="Dumpster">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry>
          <box>
            <size>2.0 1.2 1.5</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>1.5 1.5 1.5</scale>
            <uri>model://dumpster/meshes/dumpster.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <script>
            <uri>model://dumpster/materials/scripts</uri>
            <uri>model://dumpster/materials/textures</uri>
            <name>Dumpster/Diffuse</name>
          </script>
          <pbr>
            <metal>
              <albedo_map>model://dumpster/materials/textures/Dumpster_Diffuse.png</albedo_map>
              <roughness>0.76</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
