<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="Stop Sign">
    <static>true</static>
    <link name="link">
      <collision name="post_collision">
        <pose>0 0 1.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>2.1</length>
          </cylinder>
        </geometry>
      </collision>
      <collision name="sign_collision">
        <pose>0 0 2.15 0 0 0</pose>
        <geometry>
          <box>
            <size>0.75 0.06 0.75</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://stop_sign/meshes/stop_sign.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <script>
            <uri>model://stop_sign/materials/scripts</uri>
            <uri>model://stop_sign/materials/textures</uri>
            <name>StopSign/Diffuse</name>
          </script>
          <pbr>
            <metal>
              <albedo_map>model://stop_sign/materials/textures/StopSign_Diffuse.png</albedo_map>
              <roughness>0.72</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
