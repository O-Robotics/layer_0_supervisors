<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="House 2">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://house_2/meshes/house_2.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://house_2/meshes/house_2.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <script>
            <uri>model://house_2/materials/scripts</uri>
            <uri>model://house_2/materials/textures</uri>
            <uri>model://house_1/materials/textures</uri>
            <name>House_2/Diffuse</name>
          </script>
          <shader type="normal_map_tangent_space">
            <normal_map>model://house_1/materials/textures/House_1_Normal.png</normal_map>
          </shader>
          <pbr>
            <metal>
              <albedo_map>model://house_2/materials/textures/House_2_Diffuse.png</albedo_map>
              <roughness>0.84</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
