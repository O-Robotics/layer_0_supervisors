<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="post_office">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://post_office/meshes/post_office.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
