<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="city_terrain">
    <static>true</static>
    <link name="link">

      <collision name="collision">
        <pose>40 -20 -0.05 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>500 500</size>
          </plane>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e+06</kp>
              <kd>100</kd>
              <max_vel>1</max_vel>
              <min_depth>0</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>

        </surface>
      </collision>

      <visual name="visual">
        <pose>40 -20 -0.02 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>500 500</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1.0</ambient>
          <diffuse>0.55 0.55 0.55 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://city_terrain/materials/textures/city_terrain.jpg</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
