<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="empty2">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>43.2557</latitude_deg>
      <longitude_deg>-79.8711</longitude_deg>
      <elevation>100.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light name="amr_sweeper_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.4 0.6 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="perimeter_walls">
      <static>true</static>
      <link name="link">
        <collision name="north_wall">
          <pose>0 6.25 0.25 0 0 0</pose>
          <geometry><box><size>12.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>0 6.25 0.25 0 0 0</pose>
          <geometry><box><size>12.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
        <collision name="south_wall">
          <pose>0 -6.25 0.25 0 0 0</pose>
          <geometry><box><size>12.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>0 -6.25 0.25 0 0 0</pose>
          <geometry><box><size>12.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
        <collision name="east_wall">
          <pose>6.25 0 0.25 0 0 0</pose>
          <geometry><box><size>0.5 12.5 0.5</size></box></geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>6.25 0 0.25 0 0 0</pose>
          <geometry><box><size>0.5 12.5 0.5</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
        <collision name="west_wall">
          <pose>-6.25 0 0.25 0 0 0</pose>
          <geometry><box><size>0.5 12.5 0.5</size></box></geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-6.25 0 0.25 0 0 0</pose>
          <geometry><box><size>0.5 12.5 0.5</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
